# ==============================================================================
# Jamae's Craftopia Go Backend Service — Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL (.gitignore protects .env)
# ==============================================================================

# Server Port (default: 8080)
PORT=8080

# Environment mode: development | staging | production
ENVIRONMENT=development

# PostgreSQL Connection String (Cloud PostgreSQL: Supabase, Neon, Azure Database, AWS RDS)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/jamaes_craftopia?sslmode=disable

# Direct connection string for migration runners / direct pooling (optional, defaults to DATABASE_URL)
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/jamaes_craftopia?sslmode=disable

# JWT Secret for signing session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=replace_this_with_a_secure_random_32_character_string_for_production

# Merchant UPI Details for Customer Orders
MERCHANT_UPI_ID=amardeepsarkar8@okhdfcbank
MERCHANT_PAYEE_NAME=Jamae's Craftopia

# WhatsApp Customer Support & Payment Proof Verification (country code + phone number without + or spaces)
WHATSAPP_CONTACT_NUMBER=919876543210

# Allowed CORS Origin (e.g., http://localhost:3000 or https://your-store.vercel.app or *)
CORS_ORIGIN=http://localhost:3000

# Optional Database Pool Tuning (defaults auto-adjust for Serverless vs Dedicated Server)
# DB_MAX_CONNS=25
# DB_MIN_CONNS=2

