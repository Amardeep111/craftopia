# ==============================================================================
# Craftopia Backend Environment Configuration
# ==============================================================================

# Server Port (Local/Docker/VPS only; ignored in Vercel Serverless)
PORT=8080
ENVIRONMENT=production

# Supabase PostgreSQL Database (Use Transaction Pooler for Serverless)
# Port 6543 with pgbouncer=true & connection_limit=1
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Authentication Secrets
# SESSION_COOKIE_SECRET / AUTH_SECRET must be at least 32 characters
# Used to encrypt the "jamaes_session" cookie via AES-256-GCM (enc.v1.<iv>.<tag>.<ciphertext>)
SESSION_COOKIE_SECRET=your-32-char-random-cookie-secret-key-here
AUTH_SECRET=your-32-char-random-cookie-secret-key-here
JWT_SECRET=your-fallback-jwt-secret-key-here

# Optional: RSA-OAEP private key (PKCS#8 DER base64) for client-side encrypted passwords
PASSWORD_ENCRYPTION_PRIVATE_KEY=

# Manual UPI Checkout Details
MERCHANT_UPI_ID=amardeepsarkar8@okhdfcbank
MERCHANT_PAYEE_NAME=Jamae's Craftopia
WHATSAPP_CONTACT_NUMBER=916909476388

# Cloudinary Signed Image Uploads (Settings > Access Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP Email Notifications (Optional for order/request alerts)
GMAIL_USER=your_gmail_account@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_digit_app_password
EMAIL_FROM="Jamae's Craftopia <no-reply@jamaescraftopia.com>"
SUPPORT_EMAIL=support@jamaescraftopia.com

# CORS Allowed Origin (Set to your frontend URL or comma-separated list)
CORS_ORIGIN=https://jamaescraftopia.com,https://your-frontend.vercel.app,http://localhost:3000
