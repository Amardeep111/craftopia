# ==============================================================================
# Jamae's Craftopia — Decoupled REST Frontend Environment Variables Template
# DO NOT COMMIT REAL SECRETS TO GITHUB (.gitignore protects .env and .env.local)
# ==============================================================================

# 1. Go Backend Service URL (Required for Server-Side Rendering and Next.js /api rewrites)
# Local development: http://localhost:8080
# Production: https://api.yourdomain.com (or your Vercel/Azure Go backend URL)
GO_BACKEND_URL=http://localhost:8080

# 2. Public REST API URL (Optional)
# Leave EMPTY to use same-origin /api proxy (avoids CORS issues).
# If set, the browser will make direct HTTP requests to this backend URL.
NEXT_PUBLIC_API_URL=

# 3. Interactive Location Picker (Optional)
# Mapbox public access token for address picker pin drops
NEXT_PUBLIC_MAPBOX_TOKEN=

# 4. Storefront App URL (Auto-set on Vercel via VERCEL_URL)
APP_URL=http://localhost:3000
