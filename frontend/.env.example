# ==============================================================================
# Craftopia Next.js 15 SSR Frontend Environment Configuration
# ==============================================================================

# Backend Go API Service URL
# Local frontend testing uses the live backend; no local backend is required.
# In production on Vercel: https://craftopia-backend.vercel.app (or custom domain)
GO_BACKEND_URL=https://craftopia-backend.vercel.app
# Leave NEXT_PUBLIC_API_URL unset to use the same-origin /api proxy and session cookies.

# Public Storefront URL (used for canonical URLs, OpenGraph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://craftopia-store.vercel.app

# Cloudinary Public Name (for image transformations & gallery)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Mapbox Public Access Token (for customer address geocoding & maps)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VyIiwiYSI6InlvdXItdG9rZW4ifQ.example
